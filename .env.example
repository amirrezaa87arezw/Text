BOT_TOKEN=توکن-ربات-تلگرامت-از-BotFather

# gemini (رایگان و پیشنهادی) / openai / claude
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# برای قابلیت «بشنو چطوری میشه» (تبدیل متن به گفتار) - اختیاریه، اگه خالی
# بمونه فقط دکمه‌ی ویس با خطا مواجه میشه ولی بقیه‌ی ربات درست کار می‌کنه
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

DB_PATH=bot.db
